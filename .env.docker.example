# Archivo de entorno para ejecutar Monitores en Docker junto con Aulas.
# Copiar como .env.docker y reemplazar todos los valores CHANGE_ME.

MONITORES_ENV_FILE=.env.docker
AULAS_NETWORK_NAME=aulas_internal
APP_PORT=8002

# Django
SECRET_KEY=CHANGE_ME_monitores_django_secret
DEBUG=false
APP_ENV=production
ALLOWED_HOSTS=localhost,127.0.0.1,monitores-api,app
CSRF_TRUSTED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
TIME_ZONE=America/Bogota
LOG_LEVEL=INFO

# Base de datos interna del compose de Monitores.
POSTGRES_DB=monitores
POSTGRES_USER=monitores
POSTGRES_PASSWORD=CHANGE_ME_monitores_database_password
DATABASE_URL=postgres://monitores:CHANGE_ME_monitores_database_password@monitores-db:5432/monitores
DATABASE_CONN_MAX_AGE=60
DATABASE_CONN_HEALTH_CHECKS=true

# Redis es opcional para la ejecución inline.
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=true
CELERY_LOG_LEVEL=info

# Archivos y arranque del contenedor
IMPORT_DROPZONE_PATH=/app/dropzone/marcaciones.xlsx
APPLY_MIGRATIONS=1
COLLECT_STATIC=0
RUN_SEED_DATA=0
DATABASE_WAIT_TIMEOUT=60
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
SEED_DEFAULT_PASSWORD=CHANGE_ME_seed_password

# Integración con el backend de Aulas dentro de aulas_internal.
# Debe coincidir con JWT_SECRET de Aulas.
FRONTEND_URL=http://localhost:3001
PLATFORM_JWT_SECRET=CHANGE_ME_same_value_as_aulas_JWT_SECRET
PLATFORM_API_URL=http://backend:3000
PLATFORM_API_TIMEOUT_SECONDS=5
# Debe coincidir con MONITORES_SERVICE_TOKEN de Aulas.
MONITORES_SERVICE_TOKEN=CHANGE_ME_same_value_as_aulas_service_token
